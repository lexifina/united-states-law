{"section": "101", "heading": "Enacting clause", "source_credit": "(July 30, 1947, ch. 388, 61 Stat. 634.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-87", "pl119-103", "pl119-134"], "sha256": "c351c85b20aa07a3b6f4dd9315cd22e3a225a7effe2ea22ec475a73657e229d4", "heading": "Enacting clause", "lines": [{"path": "", "level": 0, "text": "The enacting clause of all Acts of Congress shall be in the following form: \"Be it enacted by the Senate and House of Representatives of the United States of America in Congress assembled.\""}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}