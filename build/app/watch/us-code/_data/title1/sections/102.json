{"section": "102", "heading": "Resolving clause", "source_credit": "(July 30, 1947, ch. 388, 61 Stat. 634.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-87", "pl119-103", "pl119-134"], "sha256": "aaa5cb7e0cbe7b6ff744b3476fb84c2f3335f10cfe53880d296186c0a8044e64", "heading": "Resolving clause", "lines": [{"path": "", "level": 0, "text": "The resolving clause of all joint resolutions shall be in the following form: \"Resolved by the Senate and House of Representatives of the United States of America in Congress assembled.\""}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}