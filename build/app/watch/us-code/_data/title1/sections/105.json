{"section": "105", "heading": "Title of appropriation Acts", "source_credit": "(July 30, 1947, ch. 388, 61 Stat. 634; Pub. L. 93–344, title V, §506(a), July 12, 1974, 88 Stat. 322.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-87", "pl119-103", "pl119-134"], "sha256": "682c059ee4a8b174b4d83f40c0fcc8ac467b81fe80bd281b2213414d388d04b0", "heading": "Title of appropriation Acts", "lines": [{"path": "", "level": 0, "text": "The style and title of all Acts making appropriations for the support of Government shall be as follows: \"An Act making appropriations (here insert the object) for the year ending September 30 (here insert the calendar year).\""}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}