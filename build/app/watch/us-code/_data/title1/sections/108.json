{"section": "108", "heading": "Repeal of repealing act", "source_credit": "(July 30, 1947, ch. 388, 61 Stat. 635.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-87", "pl119-103", "pl119-134"], "sha256": "a0983e40b4fcf35d637dcf7099debffb192721111f2836a54fa669735ae9a6eb", "heading": "Repeal of repealing act", "lines": [{"path": "", "level": 0, "text": "Whenever an Act is repealed, which repealed a former Act, such former Act shall not thereby be revived, unless it shall be expressly so provided."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}