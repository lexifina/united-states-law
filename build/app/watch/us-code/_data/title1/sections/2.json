{"section": "2", "heading": "\"County\" as including \"parish\", and so forth", "source_credit": "(July 30, 1947, ch. 388, 61 Stat. 633.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-87", "pl119-103", "pl119-134"], "sha256": "4706380cb733aaa87238a37e2c16fdf485a722681eeb45944cbf3512421c8c9f", "heading": "\"County\" as including \"parish\", and so forth", "lines": [{"path": "", "level": 0, "text": "The word \"county\" includes a parish, or any other equivalent subdivision of a State or Territory of the United States."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}