{"section": "1108", "heading": "Authorization to operate business", "source_credit": "(Pub. L. 95–598, Nov. 6, 1978, 92 Stat. 2629; Pub. L. 98–353, title III, §504, July 10, 1984, 98 Stat. 384.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-134"], "sha256": "8a6a81de9ee6ea4b953cca3dccfa1a03645c77e44671da2f0ba52fdcbd2e0e7a", "heading": "Authorization to operate business", "lines": [{"path": "", "level": 0, "text": "Unless the court, on request of a party in interest and after notice and a hearing, orders otherwise, the trustee may operate the debtor's business."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}