{"section": "307", "heading": "United States trustee", "source_credit": "(Added Pub. L. 99–554, title II, §205(a), Oct. 27, 1986, 100 Stat. 3098.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-134"], "sha256": "bb8f5c0bc1c88e70f5a992b11c3d1ff545316608f452604f71abef2ee4856498", "heading": "United States trustee", "lines": [{"path": "", "level": 0, "text": "The United States trustee may raise and may appear and be heard on any issue in any case or proceeding under this title but may not file a plan pursuant to section 1121(c) of this title."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}