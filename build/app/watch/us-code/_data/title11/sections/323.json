{"section": "323", "heading": "Role and capacity of trustee", "source_credit": "(Pub. L. 95–598, Nov. 6, 1978, 92 Stat. 2562.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-134"], "sha256": "97fdb356aff5d08a28d2464b95d68ac9d31e438a2ccd00a1528d4ec4f9f4e1ff", "heading": "Role and capacity of trustee", "lines": [{"path": "(a)", "level": 0, "text": "(a) The trustee in a case under this title is the representative of the estate."}, {"path": "(b)", "level": 0, "text": "(b) The trustee in a case under this title has capacity to sue and be sued."}]}], "records": [], "blame": [{"path": "(a)", "record": null, "law": null, "edition": null}, {"path": "(b)", "record": null, "law": null, "edition": null}], "adjustments": []}