{"section": "325", "heading": "Effect of vacancy", "source_credit": "(Pub. L. 95–598, Nov. 6, 1978, 92 Stat. 2562.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-134"], "sha256": "7c182f8975fdbd2e318521433a4239d3bc0b5af04cf1ee272a3ed2c45f1675a7", "heading": "Effect of vacancy", "lines": [{"path": "", "level": 0, "text": "A vacancy in the office of trustee during a case does not abate any pending action or proceeding, and the successor trustee shall be substituted as a party in such action or proceeding."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}