{"section": "344", "heading": "Self-incrimination; immunity", "source_credit": "(Pub. L. 95–598, Nov. 6, 1978, 92 Stat. 2565.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-134"], "sha256": "7188c374fb0a0f1f8f2302d80e8c358e32167b9593725a81edea729a13adb187", "heading": "Self-incrimination; immunity", "lines": [{"path": "", "level": 0, "text": "Immunity for persons required to submit to examination, to testify, or to provide information in a case under this title may be granted under part V of title 18."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}