{"section": "350", "heading": "Closing and reopening cases", "source_credit": "(Pub. L. 95–598, Nov. 6, 1978, 92 Stat. 2569; Pub. L. 98–353, title III, §439, July 10, 1984, 98 Stat. 370.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-134"], "sha256": "b97da696b4be61333477c809570bdcbab325f61b1a2485cb3197ffebef777722", "heading": "Closing and reopening cases", "lines": [{"path": "(a)", "level": 0, "text": "(a) After an estate is fully administered and the court has discharged the trustee, the court shall close the case."}, {"path": "(b)", "level": 0, "text": "(b) A case may be reopened in the court in which such case was closed to administer assets, to accord relief to the debtor, or for other cause."}]}], "records": [], "blame": [{"path": "(a)", "record": null, "law": null, "edition": null}, {"path": "(b)", "record": null, "law": null, "edition": null}], "adjustments": []}