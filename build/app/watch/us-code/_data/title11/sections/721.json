{"section": "721", "heading": "Authorization to operate business", "source_credit": "(Pub. L. 95–598, Nov. 6, 1978, 92 Stat. 2606.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-134"], "sha256": "ea86ed2b91729f631795ea115f3b0c6b409c47e7f3c5b3eaca2973dd8ee3b443", "heading": "Authorization to operate business", "lines": [{"path": "", "level": 0, "text": "The court may authorize the trustee to operate the business of the debtor for a limited period, if such operation is in the best interest of the estate and consistent with the orderly liquidation of the estate."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}