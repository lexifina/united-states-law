{"section": "784", "heading": "Right to be heard", "source_credit": "(Added Pub. L. 106–554, §1(a)(5) [title I, §112(c)(5)(B)], Dec. 21, 2000, 114 Stat. 2763, 2763A–395.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-134"], "sha256": "18420aae44d9367db0220843f5c2c3a7eb0d25ec26d22d94557a56a1611dd46c", "heading": "Right to be heard", "lines": [{"path": "", "level": 0, "text": "The Board or a Federal reserve bank (in the case of a clearing bank that is a member of that bank) may raise and may appear and be heard on any issue in a case under this subchapter."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}