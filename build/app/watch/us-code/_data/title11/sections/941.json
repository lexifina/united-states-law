{"section": "941", "heading": "Filing of plan", "source_credit": "(Pub. L. 95–598, Nov. 6, 1978, 92 Stat. 2624.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-83", "pl119-134"], "sha256": "bb3cbfd68c19b4e5a9e35c79d5f1326506bc271c1e82cdd7925721e8f85bbf2a", "heading": "Filing of plan", "lines": [{"path": "", "level": 0, "text": "The debtor shall file a plan for the adjustment of the debtor's debts. If such a plan is not filed with the petition, the debtor shall file such a plan at such later time as the court fixes."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}