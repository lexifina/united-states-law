{"section": "184", "heading": "Definitions", "source_credit": "(Added Pub. L. 94–521, §8(a), Oct. 17, 1976, 90 Stat. 2463.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "6ddd40bf8a2c53f7ebbaa7460c94b481db81670ed6e9f9f1b786f2bb0a8e2b0c", "heading": "Definitions", "lines": [{"path": "", "level": 0, "text": "For purposes of this subchapter—"}, {"path": "(1)", "level": 1, "text": "(1) the term \"local unit of general purpose government\" means the government of a county, municipality, township, Indian tribe, Alaskan native village, or other unit of government (other than a State) which is a unit of general government, and"}, {"path": "(2)", "level": 1, "text": "(2) the term \"State\" includes the District of Columbia."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}, {"path": "(1)", "record": null, "law": null, "edition": null}, {"path": "(2)", "record": null, "law": null, "edition": null}], "adjustments": []}