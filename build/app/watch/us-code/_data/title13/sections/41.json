{"section": "41", "heading": "Collection and publication", "source_credit": "(Aug. 31, 1954, ch. 1158, 68 Stat. 1016.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "5da9ddf7ac7ef72ec2ca4c842ff2261a49058d4fe28d08f1f24fe9fe209ff2c7", "heading": "Collection and publication", "lines": [{"path": "", "level": 0, "text": "The Secretary shall collect and publish statistics concerning the—"}, {"path": "(1)", "level": 1, "text": "(1) amount of cotton ginned;"}, {"path": "(2)", "level": 1, "text": "(2) quantity of raw cotton consumed in manufacturing establishments of every character;"}, {"path": "(3)", "level": 1, "text": "(3) quantity of baled cotton on hand;"}, {"path": "(4)", "level": 1, "text": "(4) number of active consuming cotton spindles;"}, {"path": "(5)", "level": 1, "text": "(5) number of active spindle hours; and"}, {"path": "(6)", "level": 1, "text": "(6) quantity of cotton imported and exported, with the country of origin and destination."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}, {"path": "(1)", "record": null, "law": null, "edition": null}, {"path": "(2)", "record": null, "law": null, "edition": null}, {"path": "(3)", "record": null, "law": null, "edition": null}, {"path": "(4)", "record": null, "law": null, "edition": null}, {"path": "(5)", "record": null, "law": null, "edition": null}, {"path": "(6)", "record": null, "law": null, "edition": null}], "adjustments": []}