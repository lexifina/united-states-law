{"section": "1308", "heading": "Exclusive rights", "source_credit": "(Added Pub. L. 105–304, title V, §502, Oct. 28, 1998, 112 Stat. 2908.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "18ad8943977119756ac68e8e135ab38d9ce8cf54319ba85f891d0b095adbacb5", "heading": "Exclusive rights", "lines": [{"path": "", "level": 0, "text": "The owner of a design protected under this chapter has the exclusive right to—"}, {"path": "(1)", "level": 1, "text": "(1) make, have made, or import, for sale or for use in trade, any useful article embodying that design; and"}, {"path": "(2)", "level": 1, "text": "(2) sell or distribute for sale or for use in trade any useful article embodying that design."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}, {"path": "(1)", "record": null, "law": null, "edition": null}, {"path": "(2)", "record": null, "law": null, "edition": null}], "adjustments": []}