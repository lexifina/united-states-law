{"section": "1329", "heading": "Relation to design patent law", "source_credit": "(Added Pub. L. 105–304, title V, §502, Oct. 28, 1998, 112 Stat. 2916.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "89f77fb99f0a90968cc9792087137062a8e971e9a85b6858c39f5b024fab721f", "heading": "Relation to design patent law", "lines": [{"path": "", "level": 0, "text": "The issuance of a design patent under title 35, United States Code, for an original design for an article of manufacture shall terminate any protection of the original design under this chapter."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}