{"section": "1331", "heading": "Administrator; Office of the Administrator", "source_credit": "(Added Pub. L. 105–304, title V, §502, Oct. 28, 1998, 112 Stat. 2916.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "d1ac8da01e8be50491cfb91e9efed5cde1af84ae69617c039c21e5f18a40a002", "heading": "Administrator; Office of the Administrator", "lines": [{"path": "", "level": 0, "text": "In this chapter, the \"Administrator\" is the Register of Copyrights, and the \"Office of the Administrator\" and the \"Office\" refer to the Copyright Office of the Library of Congress."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}