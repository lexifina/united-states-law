{"section": "1332", "heading": "No retroactive effect", "source_credit": "(Added Pub. L. 105–304, title V, §502, Oct. 28, 1998, 112 Stat. 2916.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "8c55df922c8872b454b15d9a14f5ef7914ad2774194f322e13fe9a9c976659f6", "heading": "No retroactive effect", "lines": [{"path": "", "level": 0, "text": "Protection under this chapter shall not be available for any design that has been made public under section 1310(b) before the effective date of this chapter."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}