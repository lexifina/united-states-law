{"section": "305", "heading": "Duration of copyright: Terminal date", "source_credit": "(Pub. L. 94–553, title I, §101, Oct. 19, 1976, 90 Stat. 2576.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "574a3c8f4a710ef71c37b12c98cdfe28a3aa6f6a183c08aa124994c313f520ab", "heading": "Duration of copyright: Terminal date", "lines": [{"path": "", "level": 0, "text": "All terms of copyright provided by sections 302 through 304 run to the end of the calendar year in which they would otherwise expire."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}