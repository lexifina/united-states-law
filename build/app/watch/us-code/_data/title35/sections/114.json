{"section": "114", "heading": "Models, specimens", "source_credit": "(July 19, 1952, ch. 950, 66 Stat. 799; Pub. L. 106–113, div. B, §1000(a)(9) [title IV, §4732(a)(10)(A)], Nov. 29, 1999, 113 Stat. 1536, 1501A–582; Pub. L. 107–273, div. C, title III, §13206(b)(1)(B), Nov. 2, 2002, 116 Stat. 1906.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "c8c4023dc2e09f9538839f2e5e6cf3651d7425efef607b08b75c91b4f8c35047", "heading": "Models, specimens", "lines": [{"path": "", "level": 0, "text": "The Director may require the applicant to furnish a model of convenient size to exhibit advantageously the several parts of his invention."}, {"path": "text 1", "level": 0, "text": "When the invention relates to a composition of matter, the Director may require the applicant to furnish specimens or ingredients for the purpose of inspection or experiment."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}, {"path": "text 1", "record": null, "law": null, "edition": null}], "adjustments": []}