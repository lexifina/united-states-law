{"section": "131", "heading": "Examination of application", "source_credit": "(July 19, 1952, ch. 950, 66 Stat. 801; Pub. L. 106–113, div. B, §1000(a)(9) [title IV, §4732(a)(10)(A)], Nov. 29, 1999, 113 Stat. 1536, 1501A–582; Pub. L. 107–273, div. C, title III, §13206(b)(1)(B), Nov. 2, 2002, 116 Stat. 1906.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "56c336cd058a6f4a8774be9b059e8ca9cd50b4e2439f18e5023f010f648c2ec6", "heading": "Examination of application", "lines": [{"path": "", "level": 0, "text": "The Director shall cause an examination to be made of the application and the alleged new invention; and if on such examination it appears that the applicant is entitled to a patent under the law, the Director shall issue a patent therefor."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}