{"section": "152", "heading": "Issue of patent to assignee", "source_credit": "(July 19, 1952, ch. 950, 66 Stat. 804; Pub. L. 93–596, §1, Jan. 2, 1975, 88 Stat. 1949.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "c7a0d6a334279a4a22d9bd7700370a008890bebc61332dde9529712670c1fd05", "heading": "Issue of patent to assignee", "lines": [{"path": "", "level": 0, "text": "Patents may be granted to the assignee of the inventor of record in the Patent and Trademark Office, upon the application made and the specification sworn to by the inventor, except as otherwise provided in this title."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}