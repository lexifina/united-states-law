{"section": "162", "heading": "Description, claim", "source_credit": "(July 19, 1952, ch. 950, 66 Stat. 804; Pub. L. 112–29, §20(j), Sept. 16, 2011, 125 Stat. 335.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "c1c0f12a5f936dd415e9073543973daa7cd2ebcc23bead2ef59e5df080c02e28", "heading": "Description, claim", "lines": [{"path": "", "level": 0, "text": "No plant patent shall be declared invalid for noncompliance with section 112 if the description is as complete as is reasonably possible."}, {"path": "text 1", "level": 0, "text": "The claim in the specification shall be in formal terms to the plant shown and described."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}, {"path": "text 1", "record": null, "law": null, "edition": null}], "adjustments": []}