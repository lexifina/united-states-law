{"section": "172", "heading": "Right of priority", "source_credit": "(July 19, 1952, ch. 950, 66 Stat. 805; Pub. L. 103–465, title V, §532(c)(2), Dec. 8, 1994, 108 Stat. 4987; Pub. L. 112–29, §§3(g)(1), 20(j), Sept. 16, 2011, 125 Stat. 288, 335.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "54bacb91aa398658c07b172c454494b7bf3eeb6c6fb1a471ba423002fa946615", "heading": "Right of priority", "lines": [{"path": "", "level": 0, "text": "The right of priority provided for by subsections (a) through (d) of section 119 shall be six months in the case of designs. The right of priority provided for by section 119(e) shall not apply to designs."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}