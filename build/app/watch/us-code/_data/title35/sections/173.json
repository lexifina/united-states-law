{"section": "173", "heading": "Term of design patent", "source_credit": "(July 19, 1952, ch. 950, 66 Stat. 805; Pub. L. 97–247, §16, Aug. 27, 1982, 96 Stat. 321; Pub. L. 103–465, title V, §532(c)(3), Dec. 8, 1994, 108 Stat. 4987; Pub. L. 112–211, title I, §102(7), Dec. 18, 2012, 126 Stat. 1532.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "98e6eb46891f299d7b5d79d399c7f3425d0e35fb4ce94b4787ab457dc74cd5c3", "heading": "Term of design patent", "lines": [{"path": "", "level": 0, "text": "Patents for designs shall be granted for the term of 15 years from the date of grant."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}