{"section": "211", "heading": "Relationship to antitrust laws", "source_credit": "(Added Pub. L. 96–517, §6(a), Dec. 12, 1980, 94 Stat. 3027.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "dc1acb32f3493602428d5022d4bd7fb2e04cfaa9e96eea6e7e3b32e34eaa77ce", "heading": "Relationship to antitrust laws", "lines": [{"path": "", "level": 0, "text": "Nothing in this chapter shall be deemed to convey to any person immunity from civil or criminal liability, or to create any defenses to actions, under any antitrust law."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}