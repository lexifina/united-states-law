{"section": "374", "heading": "Publication of international application", "source_credit": "(Added Pub. L. 94–131, §1, Nov. 14, 1975, 89 Stat. 689; amended Pub. L. 106–113, div. B, §1000(a)(9) [title IV, §4507(10)], Nov. 29, 1999, 113 Stat. 1536, 1501A–566; Pub. L. 107–273, div. C, title III, §13205(2)(E), Nov. 2, 2002, 116 Stat. 1903; Pub. L. 112–29, §§3(g)(4), 20(j), Sept. 16, 2011, 125 Stat. 288, 335.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "40d80cc26003d0fc0cf9cbe10133d736ca9c7aaa767a33aa913f1a10b2789a7c", "heading": "Publication of international application", "lines": [{"path": "", "level": 0, "text": "The publication under the treaty defined in section 351(a), of an international application designating the United States shall be deemed a publication under section 122(b), except as provided in section 154(d)."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}