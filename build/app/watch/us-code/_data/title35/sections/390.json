{"section": "390", "heading": "Publication of international design application", "source_credit": "(Added Pub. L. 112–211, title I, §101(a), Dec. 18, 2012, 126 Stat. 1531.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "7cec68fab1f8a60c1595e44deb152cf2a574115ad8e592fea8529b4c2daa0aa9", "heading": "Publication of international design application", "lines": [{"path": "", "level": 0, "text": "The publication under the treaty of an international design application designating the United States shall be deemed a publication under section 122(b)."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}