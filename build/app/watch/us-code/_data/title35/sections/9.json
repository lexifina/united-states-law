{"section": "9", "heading": "Certified copies of records", "source_credit": "(July 19, 1952, ch. 950, 66 Stat. 794, §10; Pub. L. 93–596, §1, Jan. 2, 1975, 88 Stat. 1949; renumbered §9 and amended Pub. L. 106–113, div. B, §1000(a)(9) [title IV, §§4717(1), 4732(a)(10)(A)], Nov. 29, 1999, 113 Stat. 1536, 1501A–580, 1501A–582; Pub. L. 107–273, div. C, title III, §13206(b)(1)(B), Nov. 2, 2002, 116 Stat. 1906.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-103", "pl119-134"], "sha256": "6cff4b9c5210b4137faf3d136265f00563ffd498e059557f7b8b621eeef39f7f", "heading": "Certified copies of records", "lines": [{"path": "", "level": 0, "text": "The Director may furnish certified copies of specifications and drawings of patents issued by the Patent and Trademark Office, and of other records available either to the public or to the person applying therefor."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}