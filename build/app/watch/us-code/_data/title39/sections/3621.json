{"section": "3621", "heading": "Applicability; definitions", "source_credit": "(Added Pub. L. 109–435, title II, §201(a), Dec. 20, 2006, 120 Stat. 3200.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "7ba6c909dd798b2f5c910714494014b68727c9cdbd913769c74cfa8d7b1e1e06", "heading": "Applicability; definitions", "lines": [{"path": "(a)", "level": 0, "text": "(a) Applicability.—This subchapter shall apply with respect to—"}, {"path": "(a)(1)", "level": 1, "text": "(1) first-class mail letters and sealed parcels;"}, {"path": "(a)(2)", "level": 1, "text": "(2) first-class mail cards;"}, {"path": "(a)(3)", "level": 1, "text": "(3) periodicals;"}, {"path": "(a)(4)", "level": 1, "text": "(4) standard mail;"}, {"path": "(a)(5)", "level": 1, "text": "(5) single-piece parcel post;"}, {"path": "(a)(6)", "level": 1, "text": "(6) media mail;"}, {"path": "(a)(7)", "level": 1, "text": "(7) bound printed matter;"}, {"path": "(a)(8)", "level": 1, "text": "(8) library mail;"}, {"path": "(a)(9)", "level": 1, "text": "(9) special services; and"}, {"path": "(a)(10)", "level": 1, "text": "(10) single-piece international mail,"}, {"path": "(a) closing words 1", "level": 0, "text": "subject to any changes the Postal Regulatory Commission may make under section 3642."}, {"path": "(b)", "level": 0, "text": "(b) Rule of Construction.—Mail matter referred to in subsection (a) shall, for purposes of this subchapter, be considered to have the meaning given to such mail matter under the mail classification schedule."}]}], "records": [], "blame": [{"path": "(a)", "record": null, "law": null, "edition": null}, {"path": "(a)(1)", "record": null, "law": null, "edition": null}, {"path": "(a)(2)", "record": null, "law": null, "edition": null}, {"path": "(a)(3)", "record": null, "law": null, "edition": null}, {"path": "(a)(4)", "record": null, "law": null, "edition": null}, {"path": "(a)(5)", "record": null, "law": null, "edi