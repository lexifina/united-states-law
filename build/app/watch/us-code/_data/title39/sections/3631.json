{"section": "3631", "heading": "Applicability; definitions and updates", "source_credit": "(Added Pub. L. 109–435, title II, §202, Dec. 20, 2006, 120 Stat. 3205.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "593103a92615578a7fb91c910a47611d6d0bfd8a087824e676e5a518f8ebc12f", "heading": "Applicability; definitions and updates", "lines": [{"path": "(a)", "level": 0, "text": "(a) Applicability.—This subchapter shall apply with respect to—"}, {"path": "(a)(1)", "level": 1, "text": "(1) priority mail;"}, {"path": "(a)(2)", "level": 1, "text": "(2) expedited mail;"}, {"path": "(a)(3)", "level": 1, "text": "(3) bulk parcel post;"}, {"path": "(a)(4)", "level": 1, "text": "(4) bulk international mail; and"}, {"path": "(a)(5)", "level": 1, "text": "(5) mailgrams;"}, {"path": "(a) closing words 1", "level": 0, "text": "subject to subsection (d) and any changes the Postal Regulatory Commission may make under section 3642."}, {"path": "(b)", "level": 0, "text": "(b) Definition.—For purposes of this subchapter, the term \"costs attributable\", as used with respect to a product, means the direct and indirect postal costs attributable to such product through reliably identified causal relationships."}, {"path": "(c)", "level": 0, "text": "(c) Rule of Construction.—Mail matter referred to in subsection (a) shall, for purposes of this subchapter, be considered to have the meaning given to such mail matter under the mail classification schedule."}]}], "records": [], "blame": [{"path": "(a)", "record": null, "law": null, "edition": null}, {"path": "(a)(1)", "record": null, "law": null, "edition": null}, {"path": "(a)(2)", "record": null, "law": null, "edition": null}, {"path": "(a)(3)", "record": null, "law": null, "edition": null}, {"path": "(a)(4)", "record": null, "law": null, "edition": null}, {"path": "(a)(5)", "record": null, "law": null, "edition": null}, {"path": "(a) closing words 1", "record": null, "law": null, "edition": null}, {"path": "(b)", "record": null, "law": null, "edition": null}, {"path": "(c)", "record": null, "law": null, "edition": null}], "adjustments": []}