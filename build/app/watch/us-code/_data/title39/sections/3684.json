{"section": "3684", "heading": "Limitations", "source_credit": "(Pub. L. 91–375, Aug. 12, 1970, 84 Stat. 765; Pub. L. 99–410, title II, §201(b)(4), Aug. 28, 1986, 100 Stat. 929; Pub. L. 109–435, title X, §1010(f), Dec. 20, 2006, 120 Stat. 3262.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "21c904de37cd1ed44ae036099b996a05245502a8d57ca67c13eae9727bc86525", "heading": "Limitations", "lines": [{"path": "", "level": 0, "text": "Except as provided in section 3627 of this title, no provision of this chapter shall be construed to give authority to the Governors to make any change in any provision of this title."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}