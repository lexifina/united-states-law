{"section": "5003", "heading": "Establishment of post roads", "source_credit": "(Pub. L. 91–375, Aug. 12, 1970, 84 Stat. 766.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "ac0748d2afd8be8f2055778276662a434126a835e374ec81b25645851001cb87", "heading": "Establishment of post roads", "lines": [{"path": "", "level": 0, "text": "The following are post roads:"}, {"path": "(1)", "level": 1, "text": "(1) the waters of the United States, during the time the mail is carried thereon;"}, {"path": "(2)", "level": 1, "text": "(2) railroads or parts of railroads and air routes in operation;"}, {"path": "(3)", "level": 1, "text": "(3) canals, during the time the mail is carried thereon;"}, {"path": "(4)", "level": 1, "text": "(4) public roads, highways, and toll roads during the time the mail is carried thereon; and"}, {"path": "(5)", "level": 1, "text": "(5) letter-carrier routes established for the collection and delivery of mail."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}, {"path": "(1)", "record": null, "law": null, "edition": null}, {"path": "(2)", "record": null, "law": null, "edition": null}, {"path": "(3)", "record": null, "law": null, "edition": null}, {"path": "(4)", "record": null, "law": null, "edition": null}, {"path": "(5)", "record": null, "law": null, "edition": null}], "adjustments": []}