{"section": "5403", "heading": "Fines", "source_credit": "(Pub. L. 91–375, Aug. 12, 1970, 84 Stat. 773.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "0964734194ce4e1693028a34cdd162a90f033669eaf7033a6894364ac8a00905", "heading": "Fines", "lines": [{"path": "", "level": 0, "text": "The Postal Service may impose or remit fines on carriers transporting mail by air on routes extending beyond the borders of the United States for—"}, {"path": "(1)", "level": 1, "text": "(1) unreasonable or unnecessary delay to mail; and"}, {"path": "(2)", "level": 1, "text": "(2) other delinquencies in the transportation of the mail."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}, {"path": "(1)", "record": null, "law": null, "edition": null}, {"path": "(2)", "record": null, "law": null, "edition": null}], "adjustments": []}