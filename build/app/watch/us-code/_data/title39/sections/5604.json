{"section": "5604", "heading": "Fines on ocean carriers", "source_credit": "(Pub. L. 91–375, Aug. 12, 1970, 84 Stat. 773.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "2111e35d66fff1fe1b6107ad58c78e4248d88d9484484c29a078527b5d1e7ad6", "heading": "Fines on ocean carriers", "lines": [{"path": "", "level": 0, "text": "The Postal Service may impose or remit fines on carriers transporting mail by vessel on routes extending beyond the borders of the United States for—"}, {"path": "(1)", "level": 1, "text": "(1) unreasonable or unnecessary delay to the mails; and"}, {"path": "(2)", "level": 1, "text": "(2) other delinquencies in the transportation of mail."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}, {"path": "(1)", "record": null, "law": null, "edition": null}, {"path": "(2)", "record": null, "law": null, "edition": null}], "adjustments": []}