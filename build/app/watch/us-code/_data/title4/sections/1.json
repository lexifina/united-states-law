{"section": "1", "heading": "Flag; stripes and stars on", "source_credit": "(July 30, 1947, ch. 389, 61 Stat. 642.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "ce7ffcf9a85aab06a9347b2c3a35739de60ab7247fbee2d665c830b715f6eb0b", "heading": "Flag; stripes and stars on", "lines": [{"path": "", "level": 0, "text": "The flag of the United States shall be thirteen horizontal stripes, alternate red and white; and the union of the flag shall be forty-eight stars, white in a blue field."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}