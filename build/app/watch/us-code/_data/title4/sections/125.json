{"section": "125", "heading": "Nonseverability", "source_credit": "(Added Pub. L. 106–252, §2(a), July 28, 2000, 114 Stat. 632.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "449b23a2299c13b130fcff0c973f3808eb61d6b502a3f3cce19734b4c2ff1ff5", "heading": "Nonseverability", "lines": [{"path": "", "level": 0, "text": "If a court of competent jurisdiction enters a final judgment on the merits that—"}, {"path": "(1)", "level": 1, "text": "(1) is based on Federal law;"}, {"path": "(2)", "level": 1, "text": "(2) is no longer subject to appeal; and"}, {"path": "(3)", "level": 1, "text": "(3) substantially limits or impairs the essential elements of sections 116 through 126 of this title,"}, {"path": "closing words 1", "level": 0, "text": "then sections 116 through 126 of this title are invalid and have no legal effect as of the date of entry of such judgment."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}, {"path": "(1)", "record": null, "law": null, "edition": null}, {"path": "(2)", "record": null, "law": null, "edition": null}, {"path": "(3)", "record": null, "law": null, "edition": null}, {"path": "closing words 1", "record": null, "law": null, "edition": null}], "adjustments": []}