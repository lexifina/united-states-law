{"section": "146", "heading": "Authorization of appropriations", "source_credit": "(Added Oct. 31, 1951, ch. 655, §12, 65 Stat. 715.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "54884e9f15291d9ae29918b3b707ac8bdb3ab683dcfd3748985c24ab029a1c05", "heading": "Authorization of appropriations", "lines": [{"path": "", "level": 0, "text": "For the purposes of this chapter, there are authorized to be appropriated, out of any money in the Treasury not otherwise appropriated, sums of not more than $50,000 for any one fiscal year."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}