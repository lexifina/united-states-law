{"section": "201", "heading": "Enforcement of Convention", "source_credit": "(Added Pub. L. 91–368, §1, July 31, 1970, 84 Stat. 692.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "adffbda379e0d14577b647c2f475195bcc45a6a8f6cee432a93eca7af37d10f1", "heading": "Enforcement of Convention", "lines": [{"path": "", "level": 0, "text": "The Convention on the Recognition and Enforcement of Foreign Arbitral Awards of June 10, 1958, shall be enforced in United States courts in accordance with this chapter."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}