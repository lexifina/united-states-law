{"section": "6", "heading": "Application heard as motion", "source_credit": "(July 30, 1947, ch. 392, 61 Stat. 671.)", "versions": [{"editions": ["2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "pl119-73", "pl119-134"], "sha256": "4da3dd571b1682b028dca4f12b6bce8696b16bfa0d5ec1bd86a4beb9d8419466", "heading": "Application heard as motion", "lines": [{"path": "", "level": 0, "text": "Any application to the court hereunder shall be made and heard in the manner provided by law for the making and hearing of motions, except as otherwise herein expressly provided."}]}], "records": [], "blame": [{"path": "", "record": null, "law": null, "edition": null}], "adjustments": []}